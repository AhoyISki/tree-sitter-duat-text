{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "duat_text",
      "camelcase": "DuatText",
      "title": "DuatText",
      "scope": "source.duat_text",
      "injection-regex": "^duat_text$",
      "class-name": "TreeSitterDuatText"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parsing for string literals in the text! family of macros from Duat",
    "authors": [
      {
        "name": "AhoyISki",
        "email": "ahoyiski@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/AhoyISki/tree-sitter-duat-text"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
